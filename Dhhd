local leaveSound = Instance.new("Sound")
leaveSound.SoundId = "rbxassetid://138081509"
leaveSound.Volume = 10
leaveSound.Parent = SoundService

local trackedParagraph = nil

Tabs.Tracker:AddButton({
    Title = "بدء تتبع اللاعب",
    Description = "يعرض تفاصيل الدخول والخروج والوقت",
    Callback = function()
        if targetPlayerName == "" then return end
        local foundPlr = nil
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Name:lower():sub(1, #targetPlayerName) == targetPlayerName:lower() then
                foundPlr = plr
                break
            end
        end

        if foundPlr then
            if not trackedParagraph then
                trackedParagraph = Tabs.Tracker:AddParagraph({
                    Title = "معلومات: " .. foundPlr.Name,
                    Content = "جاري جلب البيانات..."
                })
            end

            task.spawn(function()
                while foundPlr and foundPlr.Parent do
                    local pInfo = playerData[foundPlr.UserId]
                    if pInfo then
                        local elapsed = getPlayerTotalTime(foundPlr.UserId)
                        trackedParagraph:SetDesc(string.format("Joins: %d | Leaves: %d | Time: %02d:%02d:%02d", pInfo.joins, pInfo.leaves, math.floor(elapsed/3600), math.floor((elapsed%3600)/60), elapsed%60))
                    end
                    task.wait(1)
                end
            end)
            Fluent:Notify({ Title = "Tracker", Content = "تم بدء تتبع اللاعب: " .. foundPlr.Name, Duration = 3 })
        else
            Fluent:Notify({ Title = "خطأ", Content = "لم يتم العثور على اللاعب!", Duration = 3 })
        end
    end
})

Players.PlayerRemoving:Connect(function(plr)
    local pInfo = playerData[plr.UserId]
    if pInfo then
        if pInfo.isOnline and pInfo.joinTime then
            pInfo.totalTime = pInfo.totalTime + (os.time() - pInfo.joinTime)
            pInfo.joinTime = nil
        end
        pInfo.isOnline = false
        pInfo.leaves = pInfo.leaves + 1
    end

    if targetPlayerName ~= "" and plr.Name:lower():sub(1, #targetPlayerName) == targetPlayerName:lower() then
        leaveSound:Play()
    end
end)

